<Window x:Class="cookold.CreateListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cookold"
        mc:Ignorable="d"
        Title="Cook.Old - Избранное" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="35,5,35,5"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <StackPanel>
                                <ContentPresenter x:Name="IconContent" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Margin="0,5,0,5"/>
                                <TextBlock x:Name="ButtonText" 
                                           Text="{TemplateBinding Content}" 
                                           HorizontalAlignment="Center"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                    <Setter Property="Foreground" Value="DarkOliveGreen"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                 To="1.05" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                 To="1.05" Duration="0:0:0.2"/>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                                                    To="20" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius" 
                                                 To="10" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.ShadowDepth" 
                                                 To="5" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                 To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                 To="1" Duration="0:0:0.2"/>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                                                    To="15" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius" 
                                                 To="5" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.ShadowDepth" 
                                                 To="2" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,2,5,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="StatsStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,5,15,0"/>
        </Style>

        <Style x:Key="RecipeLinkStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="DarkOliveGreen"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style x:Key="BottomNavStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="65"/>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="DarkOliveGreen"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Padding" Value="15,0,15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontSize="16" Margin="0,0,5,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F0E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Beige">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Cook.Old - Кулинарные рецепты" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="DarkOliveGreen"
                               MouseLeftButtonDown="HomeButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <Border CornerRadius="20" Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🔍" 
                                       FontSize="16" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"
                                       Opacity="0.5"/>
                            <TextBox x:Name="SearchTextBox" 
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="Поиск в избранном..."
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Созданные рецепты" 
                               FontSize="28" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="DarkOliveGreen"/>
                    <TextBlock x:Name="FavoritesCount" 
                               Text="0 рецептов" 
                               FontSize="14" 
                               Foreground="Gray"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <WrapPanel x:Name="FavoritesPanel" Grid.Row="1">

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото пиццы" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Пицца Маргарита" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Итальянская"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Выпечка"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="30 минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Классическая итальянская пицца с томатным соусом, моцареллой и базиликом."
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="1111 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="1111 лайков"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button x:Name="RemoveFromFavorites1" 
                                        Content="Удалить рецепт" 
                                        Height="35"
                                        Margin="0,10,0,0"
                                        Background="#E8F0E8"
                                        Foreground="DarkOliveGreen"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        BorderThickness="1"
                                        BorderBrush="DarkOliveGreen"
                                        Cursor="Hand"
                                        Click="RemoveFromFavorites_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото салата" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Греческий салат" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Салаты"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Греческая"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="15 минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Свежие овощи, оливки, сыр фета и оливковое масло. Легкий и полезный салат!"
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="111 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="111 лайка"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button x:Name="RemoveFromFavorites2" 
                                        Content="Удалить рецепт" 
                                        Height="35"
                                        Margin="0,10,0,0"
                                        Background="#E8F0E8"
                                        Foreground="DarkOliveGreen"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        BorderThickness="1"
                                        BorderBrush="DarkOliveGreen"
                                        Cursor="Hand"
                                        Click="RemoveFromFavorites_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото борща" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Борщ" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Супы"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Украинская"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="60+ минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Наваристый борщ со свеклой, капустой и мясом. Традиционное украинское блюдо!"
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="11 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="1 лайков"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button x:Name="RemoveFromFavorites3" 
                                        Content="Удалить рецепт" 
                                        Height="35"
                                        Margin="0,10,0,0"
                                        Background="#E8F0E8"
                                        Foreground="DarkOliveGreen"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        BorderThickness="1"
                                        BorderBrush="DarkOliveGreen"
                                        Cursor="Hand"
                                        Click="RemoveFromFavorites_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border x:Name="EmptyCreateListMessage" 
                        Grid.Row="1" 
                        Background="White" 
                        CornerRadius="10" 
                        Padding="40" 
                        Margin="0,20,0,0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="64" HorizontalAlignment="Center"/>
                        <TextBlock Text="Нет Созданных рецептов" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="DarkOliveGreen"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>
                        <TextBlock Text="Создавайте рецепты, чтобы они появились здесь" 
                                   FontSize="14" 
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource BottomNavStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button x:Name="HomeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="HomeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="🏠" FontSize="24"/>
                                <TextBlock Text="Главная"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="FavoritesButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="FavoritesButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="❤️" FontSize="24"/>
                                <TextBlock Text="Избранное"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="CreateRecipeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="CreateRecipeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="➕" FontSize="24"/>
                                <TextBlock Text="Создать"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="ProfileButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="ProfileButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="👤" FontSize="24"/>
                                <TextBlock Text="Профиль"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>