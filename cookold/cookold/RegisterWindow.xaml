<Window x:Class="cookold.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cookold"
        mc:Ignorable="d"
        Title="Регистрация" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" Width="598" Height="750">

    <Window.Resources>
        <Style x:Key="BorderRegisterStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="550"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RegisterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Background" Value="DarkOliveGreen"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="OliveDrab"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="DarkGreen"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,-10,0,5"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="SuccessTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Green"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid Background="Beige">
        <DockPanel>
            <Border Style="{StaticResource HeaderStyle}" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <TextBlock Text="Cook.Old - Кулинарные рецепты" 
                               FontSize="30" 
                               FontWeight="Bold"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid>
            <Border Style="{StaticResource BorderRegisterStyle}">
                <StackPanel Margin="30,20,30,20">
                    <TextBlock Text="Регистрация" 
                               FontSize="24" 
                               FontFamily="Calibri" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,20"/>

                    <TextBlock Text="Электронная почта" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="0,20,0,5"/>
                    <TextBox x:Name="EmailTextBox" 
                             Style="{StaticResource TextBoxStyle}"
                             TextChanged="EmailTextBox_TextChanged">
                        <TextBox.ToolTip>
                            <ToolTip>Введите ваш email</ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <TextBlock x:Name="EmailErrorText" 
                               Style="{StaticResource ErrorTextStyle}"
                               Text="Введите корректный email адрес"/>

                    <TextBlock Text="Логин" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="0,5,0,5"/>
                    <TextBox x:Name="LoginTextBox" 
                             Style="{StaticResource TextBoxStyle}"
                             TextChanged="LoginTextBox_TextChanged">
                        <TextBox.ToolTip>
                            <ToolTip>Придумайте логин (минимум 3 символа)</ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <TextBlock x:Name="LoginErrorText" 
                               Style="{StaticResource ErrorTextStyle}"
                               Text="Логин должен содержать минимум 3 символа"/>

                    <TextBlock Text="Пароль" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="0,5,0,5"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Style="{StaticResource PasswordBoxStyle}"
                                 PasswordChanged="PasswordBox_PasswordChanged">
                        <PasswordBox.ToolTip>
                            <ToolTip>Пароль должен содержать минимум 6 символов</ToolTip>
                        </PasswordBox.ToolTip>
                    </PasswordBox>
                    <TextBlock x:Name="PasswordErrorText" 
                               Style="{StaticResource ErrorTextStyle}"
                               Text="Пароль должен содержать минимум 6 символов"/>

                    <TextBlock Text="Подтверждение пароля" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="0,5,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" 
                                 Style="{StaticResource PasswordBoxStyle}"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged">
                        <PasswordBox.ToolTip>
                            <ToolTip>Повторите ваш пароль</ToolTip>
                        </PasswordBox.ToolTip>
                    </PasswordBox>
                    <TextBlock x:Name="ConfirmPasswordErrorText" 
                               Style="{StaticResource ErrorTextStyle}"
                               Text="Пароли не совпадают"/>

                    <TextBlock x:Name="ErrorText" 
                               Style="{StaticResource ErrorTextStyle}"
                               Text="Ошибка регистрации"/>

                    <Button x:Name="RegisterButton" 
                            Style="{StaticResource RegisterButtonStyle}"
                            Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                            Click="RegisterButton_Click"
                            IsEnabled="False"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,15,0,0">
                        <TextBlock Text="Уже есть аккаунт? " 
                                   FontSize="12" 
                                   Foreground="Gray"/>
                        <TextBlock x:Name="LoginLink" 
                                   Text="Войти" 
                                   FontSize="12" 
                                   Foreground="DarkOliveGreen"
                                   Cursor="Hand"
                                   TextDecorations="Underline"
                                   MouseLeftButtonDown="LoginLink_MouseLeftButtonDown"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>