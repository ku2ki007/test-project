<Window x:Class="cookold.MainAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cookold"
        mc:Ignorable="d"
        Title="Cook.Old - Главная" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="35,5,35,5"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              IsHitTestVisible="False"/>

                                    <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="1"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <Path x:Name="Arrow"
                                      Data="M0,0 L4,4 L8,0"
                                      Fill="DarkOliveGreen"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                Background="White"
                                BorderBrush="DarkOliveGreen"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="0,2,0,0"
                                MaxHeight="200">
                                    <ScrollViewer Margin="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="DarkOliveGreen"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Margin="2">
                                        <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F0E8"/>
                                <Setter Property="Foreground" Value="DarkOliveGreen"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="DarkOliveGreen"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                 To="1.05" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                 To="1.05" Duration="0:0:0.2"/>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                                                    To="20" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius" 
                                                 To="10" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.ShadowDepth" 
                                                 To="5" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                 To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                 To="1" Duration="0:0:0.2"/>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                                                    To="15" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius" 
                                                 To="5" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.ShadowDepth" 
                                                 To="2" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <StackPanel>
                                <ContentPresenter x:Name="IconContent" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Margin="0,5,0,5"/>
                                <TextBlock x:Name="ButtonText" 
                                           Text="{TemplateBinding Content}" 
                                           HorizontalAlignment="Center"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                    <Setter Property="Foreground" Value="DarkOliveGreen"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeLinkStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="DarkOliveGreen"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,2,5,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="StatsStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,5,15,0"/>
        </Style>

        <Style x:Key="BottomNavStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="65"/>
        </Style>
    </Window.Resources>

    <Grid Background="Beige">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Cook.Old - Кулинарные рецепты" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="DarkOliveGreen"
                               MouseLeftButtonDown="HomeButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <Border CornerRadius="20" Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🔍" 
                                       FontSize="16" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"
                                       Opacity="0.5"/>
                            <TextBox x:Name="SearchTextBox" 
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     TextChanged="SearchTextBox_TextChanged"
                                     ToolTip="Поиск рецептов..."
                                     BorderThickness="0"
                                     Background="Transparent"/>
                            <Button x:Name="ClearSearchButton" 
                                    Content="✕" 
                                    Width="30" 
                                    Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="Gray"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,5,0"
                                    Cursor="Hand"
                                    Click="ClearSearchButton_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10" 
                Padding="20" 
                Margin="20,10,20,10"
                BorderBrush="DarkOliveGreen"
                BorderThickness="2">
            <StackPanel>
                <WrapPanel Margin="0,0,0,15">
                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="Категория" FontWeight="SemiBold" Margin="10,0,0,5"/>
                        <ComboBox x:Name="CategoryFilter" 
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Все категории" IsSelected="True"/>
                            <ComboBoxItem Content="Супы"/>
                            <ComboBoxItem Content="Горячие блюда"/>
                            <ComboBoxItem Content="Салаты"/>
                            <ComboBoxItem Content="Десерты"/>
                            <ComboBoxItem Content="Выпечка"/>
                            <ComboBoxItem Content="Роллы"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="Время приготовления" FontWeight="SemiBold" Margin="10,0,0,5"/>
                        <ComboBox x:Name="TimeFilter" 
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Любое" IsSelected="True"/>
                            <ComboBoxItem Content="До 30 минут"/>
                            <ComboBoxItem Content="30-60 минут"/>
                            <ComboBoxItem Content="Более 60 минут"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="Кухня" FontWeight="SemiBold" Margin="10,0,0,5"/>
                        <ComboBox x:Name="KitchenFilter" 
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Любая" IsSelected="True"/>
                            <ComboBoxItem Content="Русская"/>
                            <ComboBoxItem Content="Украинская"/>
                            <ComboBoxItem Content="Итальянская"/>
                            <ComboBoxItem Content="Китайская"/>
                            <ComboBoxItem Content="Французская"/>
                            <ComboBoxItem Content="Японская"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="Сортировка" FontWeight="SemiBold" Margin="10,0,0,5"/>
                        <ComboBox x:Name="SortFilter" 
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="По просмотрам" IsSelected="True"/>
                            <ComboBoxItem Content="По лайкам"/>
                            <ComboBoxItem Content="По названию"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,10" VerticalAlignment="Bottom">
                        <TextBlock Text="Действия" FontWeight="SemiBold" Margin="10,0,0,5" Visibility="Hidden"/>
                        <StackPanel Orientation="Horizontal" Width="385">
                            <Button x:Name="ClearFiltersButton" 
                                    Content="Сбросить фильтры" 
                                    Style="{StaticResource FilterButtonStyle}"
                                    Background="White"
                                    BorderBrush="#999"
                                    Foreground="#555"
                                    Click="ClearFiltersButton_Click" Width="162"/>
                            <Button x:Name="SaveFiltersButton" 
                                    Content="Сохранить фильтры" 
                                    Style="{StaticResource FilterButtonStyle}"
                                    Background="DarkOliveGreen"
                                    BorderBrush="DarkOliveGreen"
                                    Foreground="White"
                                    Click="SaveFiltersButton_Click" Width="182"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <WrapPanel x:Name="RecipesPanel">

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото пиццы"
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Пицца Маргарита" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Итальянская"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Выпечка"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="30 минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Классическая итальянская пицца с томатным соусом, моцареллой и базиликом."
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="111111 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="111111 лайков"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото салата" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Греческий салат" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Салаты"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Греческая"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="15 минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Свежие овощи, оливки, сыр фета и оливковое масло. Легкий и полезный салат!"
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="11111 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="11111 лайка"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото борща" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Борщ" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Супы"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Украинская"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="60+ минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Наваристый борщ со свеклой, капустой и мясом. Традиционное украинское блюдо!"
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="1111 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="1111 лайков"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото торта" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Наполеон" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Десерты"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Выпечка"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="60+ минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Классический торт Наполеон из слоеного теста с нежным заварным кремом."
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="111 просмотр"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="111 лайков"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото роллов" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Роллы Калифорния" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Японская"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Роллы"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="60 минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Популярные роллы с крабом, авокадо и икрой тобико."
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="11 просмотров"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="11 лайков"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RecipeCardStyle}" Width="350">
                        <StackPanel>
                            <Border Height="200" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="Фото залупы" 
                                           FontSize="40" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="15">
                                <TextBlock Text="Паэлья" 
                                           Style="{StaticResource RecipeLinkStyle}"
                                           MouseLeftButtonDown="Recipe_Click"/>

                                <WrapPanel Margin="0,10,0,10">
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Испанская"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="Горячие блюда"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}">
                                        <TextBlock Text="60+ минут"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Испанское блюдо из риса с морепродуктами и шафраном."
                                           FontSize="13"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="👁️ "/><Run Text="1 просмотр"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatsStyle}">
                                        <Run Text="❤️ "/><Run Text="1 лайк"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource BottomNavStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button x:Name="HomeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="HomeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="🏠" FontSize="24"/>
                                <TextBlock Text="Главная"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="FavoritesButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="FavoritesButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="❤️" FontSize="24"/>
                                <TextBlock Text="Избранное"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="CreateRecipeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="CreateRecipeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="➕" FontSize="24"/>
                                <TextBlock Text="Создать"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="ProfileButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="ProfileButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="👤" FontSize="24"/>
                                <TextBlock Text="Профиль"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>