<Window x:Class="cookold.CreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cookold"
        mc:Ignorable="d"
        Title="Cook.Old - Создание рецепта" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="35,5,35,5"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <StackPanel>
                                <ContentPresenter x:Name="IconContent" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Margin="0,5,0,5"/>
                                <TextBlock x:Name="ButtonText" 
                                           Text="{TemplateBinding Content}" 
                                           HorizontalAlignment="Center"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                    <Setter Property="Foreground" Value="DarkOliveGreen"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Margin="{TemplateBinding Padding}"
                                                      IsHitTestVisible="False"/>

                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch">
                                        <Path x:Name="Arrow"
                                              Data="M0,0 L4,4 L8,0"
                                              Fill="DarkOliveGreen"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,0,5,0"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        BorderBrush="DarkOliveGreen"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Margin="0,2,0,0"
                                        MaxHeight="200">
                                    <ScrollViewer Margin="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="DarkOliveGreen"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IngredientItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BottomNavStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="65"/>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="DarkOliveGreen"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Padding" Value="15,0,15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontSize="16" Margin="0,0,5,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F0E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="DarkOliveGreen"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="OliveDrab"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="DarkGreen"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddStepButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="DarkOliveGreen"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F0E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="EditTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditTextAreaStyle" TargetType="TextBox">
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="PlaceholderTextBox" TargetType="TextBox" BasedOn="{StaticResource EditTextBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBox x:Name="RealTextBox" 
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextBoxStyle}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="Gray"
                                       FontSize="14"
                                       Padding="10,5"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="RealTextBox" Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger SourceName="RealTextBox" Property="IsFocused" Value="True">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceholderTextArea" TargetType="TextBox" BasedOn="{StaticResource EditTextAreaStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBox x:Name="RealTextBox" 
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextAreaStyle}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="Gray"
                                       FontSize="14"
                                       Padding="10,8"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="RealTextBox" Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger SourceName="RealTextBox" Property="IsFocused" Value="True">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Beige">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Cook.Old - Кулинарные рецепты" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="DarkOliveGreen"
                               Cursor="Hand"
                               MouseLeftButtonDown="HomeButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <Border CornerRadius="20" Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🔍" 
                                       FontSize="16" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"
                                       Opacity="0.5"/>
                            <TextBox x:Name="SearchTextBox" 
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="Поиск рецептов..."
                                     BorderThickness="0"
                                     Background="Transparent"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="SaveRecipeButton" 
                            Style="{StaticResource SaveButtonStyle}"
                            Content="Сохранить рецепт"
                            Click="SaveRecipeButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <Border Background="White" 
                            CornerRadius="10" 
                            BorderBrush="LightGray" 
                            BorderThickness="1"
                            Margin="0,0,0,20"
                            Cursor="Hand"
                            MouseLeftButtonDown="UploadImage_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.15"/>
                        </Border.Effect>
                        <Grid>
                            <Border Height="300" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RecipeImage" 
                                               Text="📷 Нажмите для загрузки фото" 
                                               FontSize="20" 
                                               HorizontalAlignment="Center"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="White" 
                            CornerRadius="10" 
                            BorderBrush="LightGray" 
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Информация о блюде" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Категория:" Foreground="Gray" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" 
                                          x:Name="CategoryComboBox"
                                          Style="{StaticResource FilterComboBoxStyle}">
                                    <ComboBoxItem Content="Выберите категорию" IsSelected="True"/>
                                    <ComboBoxItem Content="Супы"/>
                                    <ComboBoxItem Content="Горячие блюда"/>
                                    <ComboBoxItem Content="Салаты"/>
                                    <ComboBoxItem Content="Десерты"/>
                                    <ComboBoxItem Content="Выпечка"/>
                                    <ComboBoxItem Content="Роллы"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Кухня:" Foreground="Gray" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" 
                                          x:Name="KitchenComboBox"
                                          Style="{StaticResource FilterComboBoxStyle}">
                                    <ComboBoxItem Content="Выберите кухню" IsSelected="True"/>
                                    <ComboBoxItem Content="Русская"/>
                                    <ComboBoxItem Content="Украинская"/>
                                    <ComboBoxItem Content="Итальянская"/>
                                    <ComboBoxItem Content="Китайская"/>
                                    <ComboBoxItem Content="Французская"/>
                                    <ComboBoxItem Content="Японская"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Время:" Foreground="Gray" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" 
                                          x:Name="TimeComboBox"
                                          Style="{StaticResource FilterComboBoxStyle}">
                                    <ComboBoxItem Content="Выберите время" IsSelected="True"/>
                                    <ComboBoxItem Content="До 30 минут"/>
                                    <ComboBoxItem Content="30-60 минут"/>
                                    <ComboBoxItem Content="Более 60 минут"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Шаги приготовления" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"/>

                    <StackPanel x:Name="StepsPanel">
                    </StackPanel>

                    <Button x:Name="AddStepButton" 
                            Style="{StaticResource AddStepButtonStyle}"
                            Content="Добавить шаг"
                            Click="AddStepButton_Click"
                            Margin="0,0,0,20"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">

                    <TextBox x:Name="RecipeTitleTextBox" 
                             Style="{StaticResource PlaceholderTextBox}"
                             Tag="Введите название блюда..."
                             Margin="0,0,0,10"/>

                    <TextBox x:Name="ShortDescriptionTextBox" 
                             Style="{StaticResource PlaceholderTextArea}"
                             Tag="Краткое описание блюда (1-2 предложения)..."
                             Margin="0,0,0,15"
                             Height="60"/>

                    <TextBlock Text="Полное описание" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    <TextBox x:Name="FullDescriptionTextBox" 
                             Style="{StaticResource PlaceholderTextArea}"
                             Tag="Подробное описание рецепта, история блюда, советы по приготовлению..."
                             Margin="0,0,0,25"
                             Height="100"/>

                    <TextBlock Text="Ингредиенты" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>

                    <Border Background="#F5F5F5" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                        <StackPanel x:Name="IngredientsPanel">
                        </StackPanel>
                    </Border>

                    <Button x:Name="AddIngredientButton" 
                            Style="{StaticResource AddStepButtonStyle}"
                            Content="Добавить ингредиент"
                            Click="AddIngredientButton_Click"
                            Margin="0,0,0,25"
                            Height="40"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource BottomNavStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button x:Name="HomeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="HomeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="🏠" FontSize="24"/>
                                <TextBlock Text="Главная"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="FavoritesButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="FavoritesButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="❤️" FontSize="24"/>
                                <TextBlock Text="Избранное"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="CreateRecipeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="CreateRecipeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="➕" FontSize="24"/>
                                <TextBlock Text="Создать"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="ProfileButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="ProfileButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="👤" FontSize="24"/>
                                <TextBlock Text="Профиль"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>