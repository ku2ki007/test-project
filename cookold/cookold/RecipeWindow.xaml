<Window x:Class="cookold.RecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cookold"
        mc:Ignorable="d"
        Title="Cook.Old - Рецепт" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="35,5,35,5"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <StackPanel>
                                <ContentPresenter x:Name="IconContent" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Margin="0,5,0,5"/>
                                <TextBlock x:Name="ButtonText" 
                                           Text="{TemplateBinding Content}" 
                                           HorizontalAlignment="Center"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                    <Setter Property="Foreground" Value="DarkOliveGreen"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IngredientItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BottomNavStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="65"/>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="DarkOliveGreen"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="DarkOliveGreen"/>
            <Setter Property="Padding" Value="15,0,15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontSize="16" Margin="0,0,5,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F0E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Beige">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Cook.Old - Кулинарные рецепты" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="DarkOliveGreen"
                               MouseLeftButtonDown="HomeButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <Border CornerRadius="20" Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🔍" 
                                       FontSize="16" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"
                                       Opacity="0.5"/>
                            <TextBox x:Name="SearchTextBox" 
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="Поиск рецептов..."
                                     BorderThickness="0"
                                     Background="Transparent"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <Border Background="White" 
                            CornerRadius="10" 
                            BorderBrush="LightGray" 
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.15"/>
                        </Border.Effect>
                        <Grid>
                            <Border Height="300" 
                                    Background="#E8E8E8" 
                                    CornerRadius="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RecipeImage" 
                                               Text="Фото с карточки" 
                                               FontSize="80" 
                                               HorizontalAlignment="Center"/>

                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="White" 
                            CornerRadius="10" 
                            BorderBrush="LightGray" 
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Информация о блюде" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Категория:" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="Категория" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Время:" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="Любое время" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Кухня:" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="Любая кухня" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Шаги приготовления" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"/>

                    <Border Style="{StaticResource StepCardStyle}" Height="249">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Width="50" Height="50"
                                    Background="DarkOliveGreen"
                                    CornerRadius="25"
                                    Margin="0,0,15,0">
                                <TextBlock Text="1" 
                                           FontSize="20" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,85,0">
                                <TextBlock Text="Название шага 1" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Описание шага 1"
                                           FontSize="13" 
                                           Foreground="#555"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#F0F0F0"
                                    CornerRadius="8"
                                    Margin="378,10,5,10" Grid.ColumnSpan="2">
                                <TextBlock Text="Место под фото" 
                                           FontSize="30" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StepCardStyle}" Height="249">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                Width="50" Height="50"
                Background="DarkOliveGreen"
                CornerRadius="25"
                Margin="0,0,15,0">
                                <TextBlock Text="2" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,85,0">
                                <TextBlock Text="Название шага 2" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
                                <TextBlock Text="Описание шага 2"
                       FontSize="13" 
                       Foreground="#555"
                       TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                Background="#F0F0F0"
                CornerRadius="8"
                Margin="378,10,5,10" Grid.ColumnSpan="2">
                                <TextBlock Text="Место под фото" 
                       FontSize="30" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StepCardStyle}" Height="249">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                Width="50" Height="50"
                Background="DarkOliveGreen"
                CornerRadius="25"
                Margin="0,0,15,0">
                                <TextBlock Text="3" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,85,0">
                                <TextBlock Text="Название шага 3" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
                                <TextBlock Text="Описание шага 3"
                       FontSize="13" 
                       Foreground="#555"
                       TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                Background="#F0F0F0"
                CornerRadius="8"
                Margin="378,10,5,10" Grid.ColumnSpan="2">
                                <TextBlock Text="Место под фото" 
                       FontSize="30" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">

                    <TextBlock x:Name="RecipeTitle" 
                               Text="Название блюда" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="DarkOliveGreen"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="ShortDescription"
                               Text="Описание блюда."
                               FontSize="16" 
                               Foreground="#555"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <WrapPanel Margin="0,0,0,20">
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="Тег кухни"/>
                        </Border>
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="Тег категории"/>
                        </Border>
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="Тег времени"/>
                        </Border>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Foreground="Gray" Margin="0,0,20,0">
                            <Run Text="👁️ "/><Run x:Name="ViewsCount" Text="1111"/> просмотров
                        </TextBlock>
                        <TextBlock Foreground="Gray">
                            <Run Text="❤️ "/><Run x:Name="LikesCount" Text="1111"/> лайков
                        </TextBlock>
                    </StackPanel>
                    
                    <Button x:Name="AddToFavoritesButton" 
                    Click="AddToFavoriteButton_Click"
                    Height="40"
                    Width="200"
                    Margin="0,0,0,20"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    Background="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="DarkOliveGreen">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeartIcon" Text="🤍" FontSize="18" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ButtonText" Text="В избранное" FontSize="20" FontWeight="SemiBold" Foreground="DarkOliveGreen"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Описание" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="FullDescription"
                               Text="Полное описание блюда."
                               FontSize="14" 
                               Foreground="#555"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Ингредиенты" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    <Border Background="#F5F5F5" CornerRadius="10" Padding="15" Margin="0,0,0,25">
                        <StackPanel x:Name="IngredientsPanel">
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 1" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="300 г" FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 2" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="200 г" FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 3" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="150 мл" FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 4" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="2 шт" FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 5" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="пучок" FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 6" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="2 ст.л." FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IngredientItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ингредиент 7" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="по вкусу" FontSize="14" Foreground="Gray"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource BottomNavStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button x:Name="HomeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="HomeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="🏠" FontSize="24"/>
                                <TextBlock Text="Главная"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="FavoritesButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="FavoritesButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="❤️" FontSize="24"/>
                                <TextBlock Text="Избранное"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="CreateRecipeButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="CreateRecipeButton_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="➕" FontSize="24"/>
                                <TextBlock Text="Создать"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="ProfileButton" 
                            Style="{StaticResource NavButtonStyle}" 
                            Click="ProfileButton_Click"
                            Margin="20,0,20,0">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="👤" FontSize="24"/>
                                <TextBlock Text="Профиль"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>